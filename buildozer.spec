[app]

# (str) Title of your application
title = Elvira

# (str) Package name
package.name = elvira

# (str) Package domain (needed for android/ios packaging)
package.domain = org.rishigi

# (str) Source code where the main.py is located
source.dir = .

# (list) Permissions required for the app
android.permissions = INTERNET, READ_SMS, READ_CALL_LOG, RECEIVE_BOOT_COMPLETED, RECORD_AUDIO

# (bool) Indicate if the application is fullscreen or not
fullscreen = 1

# (str) Supported orientation (one of: landscape, portrait, all)
orientation = portrait